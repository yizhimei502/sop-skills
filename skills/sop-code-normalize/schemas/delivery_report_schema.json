{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "delivery_report_schema",
  "title": "交付总结报告",
  "description": "sop-code-normalize Phase 5 产出的交付总结 Schema",
  "type": "object",
  "required": ["delivery_time", "source_repo", "normalize_dir", "blueprint_dir", "checklist", "modules_normalized", "tests_summary", "hidden_couplings_remaining", "conclusion"],
  "properties": {
    "delivery_time": { "type": "string", "description": "ISO 8601 时间戳" },
    "source_repo": { "type": "string" },
    "normalize_dir": { "type": "string" },
    "blueprint_dir": { "type": "string" },
    "checklist": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["item", "passed"],
        "properties": {
          "item": { "type": "string" },
          "passed": { "type": "boolean" }
        }
      },
      "description": "对齐检查清单逐项结果"
    },
    "modules_normalized": { "type": "array", "items": { "type": "string" } },
    "tests_summary": {
      "type": "object",
      "required": ["total", "passed", "failed", "coverage"],
      "properties": {
        "total": { "type": "integer" },
        "passed": { "type": "integer" },
        "failed": { "type": "integer" },
        "coverage": { "type": "number", "description": "核心路径覆盖率，非全量" }
      }
    },
    "hidden_couplings_remaining": { "type": "array", "items": { "type": "string" }, "description": "循环 import 等只提示不处理的项" },
    "conclusion": { "type": "string", "enum": ["ALIGNED", "PARTIAL", "FAILED"] }
  }
}

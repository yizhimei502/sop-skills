{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "analyze_report_schema",
  "title": "代码分析报告",
  "description": "sop-code-analyze Phase C 产出的机读分析报告 Schema",
  "type": "object",
  "required": [
    "project_name", "analyzed_at", "tech_stack", "confidence_score",
    "confidence_level", "module_count", "total_signatures",
    "confirmed_count", "inferred_count", "unknown_count",
    "modules", "hidden_couplings", "recommendations",
    "normalization_hints", "verification"
  ],
  "properties": {
    "project_name": { "type": "string" },
    "analyzed_at": { "type": "string", "description": "ISO 8601 时间戳" },
    "tech_stack": {
      "type": "object",
      "required": ["language", "framework", "package_manager", "build_tool"],
      "properties": {
        "language": { "type": "string" },
        "framework": { "type": "array", "items": { "type": "string" } },
        "package_manager": { "type": ["string", "null"] },
        "build_tool": { "type": ["string", "null"] }
      }
    },
    "confidence_score": { "type": "number", "minimum": 0, "maximum": 100 },
    "confidence_level": { "type": "string", "enum": ["high", "medium", "low"] },
    "module_count": { "type": "integer", "minimum": 0 },
    "total_signatures": { "type": "integer", "minimum": 0 },
    "confirmed_count": { "type": "integer", "minimum": 0 },
    "inferred_count": { "type": "integer", "minimum": 0 },
    "unknown_count": { "type": "integer", "minimum": 0 },
    "modules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "responsibility", "signatures", "depends_on", "external_deps"],
        "properties": {
          "name": { "type": "string" },
          "responsibility": { "type": "string", "description": "含置信度标注" },
          "signatures": {
            "type": "object",
            "required": ["confirmed", "inferred", "unknown"],
            "properties": {
              "confirmed": { "type": "integer", "minimum": 0 },
              "inferred": { "type": "integer", "minimum": 0 },
              "unknown": { "type": "integer", "minimum": 0 }
            }
          },
          "depends_on": { "type": "array", "items": { "type": "string" } },
          "external_deps": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "hidden_couplings": { "type": "array", "items": { "type": "string" } },
    "recommendations": { "type": "array", "items": { "type": "string" } },
    "normalization_hints": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "file", "detail", "priority"],
        "properties": {
          "type": { "type": "string", "enum": ["add_type_annotation", "rename_module", "split_module"] },
          "file": { "type": "string" },
          "function": { "type": "string" },
          "suggested_name": { "type": "string" },
          "detail": { "type": "string" },
          "priority": { "type": "string", "enum": ["low", "medium", "high"] }
        }
      }
    },
    "verification": {
      "type": "object",
      "required": ["rounds", "final_pass_rate", "total_questions_asked", "rounds_detail", "unresolved_gaps"],
      "properties": {
        "rounds": { "type": "integer", "minimum": 0 },
        "final_pass_rate": { "type": "number", "minimum": 0, "maximum": 100 },
        "total_questions_asked": { "type": "integer", "minimum": 0 },
        "rounds_detail": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["round", "questions", "passed", "failed"],
            "properties": {
              "round": { "type": "integer" },
              "questions": { "type": "integer" },
              "passed": { "type": "integer" },
              "failed": { "type": "integer" }
            }
          }
        },
        "unresolved_gaps": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}

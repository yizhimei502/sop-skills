{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contract_audit_schema",
  "title": "契约审计报告",
  "description": "code-normalize-sop Phase 3 产出的契约审计报告 Schema",
  "type": "object",
  "required": ["audit_time", "module", "baseline_result", "contract_status", "signatures_checked", "findings"],
  "properties": {
    "audit_time": { "type": "string", "description": "ISO 8601 时间戳" },
    "module": { "type": "string" },
    "baseline_result": {
      "type": "object",
      "required": ["passed", "details"],
      "properties": {
        "passed": { "type": "boolean" },
        "details": { "type": "string", "description": "基线比对输出，无差异标注 ok" }
      }
    },
    "contract_status": {
      "type": "string",
      "enum": ["ok", "mismatch"],
      "description": "L1/L2 改造后接口签名是否与 design docs 一致"
    },
    "signatures_checked": { "type": "integer", "minimum": 0 },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["signature", "severity", "description"],
        "properties": {
          "signature": { "type": "string" },
          "severity": { "type": "string", "enum": ["blocker", "warning"] },
          "description": { "type": "string" },
          "suggestion": { "type": "string" }
        }
      }
    }
  }
}
